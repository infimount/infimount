{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infimount",
  "version": "0.8.0",
  "identifier": "com.infimount.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../../scripts/prepare-mcp-sidecar.mjs",
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Infimount",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "minWidth": 500,
        "minHeight": 480,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc:; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://localhost:5173 ws://localhost:5173; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/mcp"
    ],
    "resources": [
      "binaries/mcp.sha256"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMjA0RDdBMzYxNkIyN0YKUldTeHNsc0RObnBOREJPR0YxeWdmbUNWblp0QjlCVTBCajczVEx4ekU2SEgvbXl1SnpUaU01ZmgK",
      "endpoints": [
        "https://github.com/infimount/infimount/releases/latest/download/latest.json"
      ]
    }
  }
}
