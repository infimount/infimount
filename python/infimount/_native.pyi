__version__: str

class InfimountError(Exception): ...
class ConfigurationError(InfimountError): ...
class InvalidRequest(InfimountError): ...
class PermissionDenied(InfimountError): ...
class ConfirmationRequired(InfimountError): ...
class NotFound(InfimountError): ...
class AlreadyExists(InfimountError): ...
class LimitExceeded(InfimountError): ...
class UnsupportedOperation(InfimountError): ...
class BackendUnavailable(InfimountError): ...

class NativeClient:
    def __init__(self, config_json: str) -> None: ...
    def list_json(self, path: str, *, limit: int = 200, cursor: str | None = None) -> str: ...
    def stat_json(self, path: str) -> str: ...
    def read(self, path: str, *, offset: int = 0, max_bytes: int | None = None) -> bytes: ...
    def write(self, path: str, data: bytes) -> int: ...
    def delete(self, path: str) -> None: ...
    def download_link_json(self, path: str, *, expires_seconds: int = 300) -> str: ...
    def drain_audit_json(self) -> str: ...
    def close(self) -> None: ...
